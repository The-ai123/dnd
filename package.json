{
  "name": "dnd-desktop",
  "productName": "Storyteller",
  "version": "0.1.0",
  "private": true,
  "description": "Offline two-window tabletop workspace",
  "author": "Storyteller contributors",
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/index.cjs",
  "engines": { "node": ">=24.0.0 <25" },
  "workspaces": ["packages/*"],
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
